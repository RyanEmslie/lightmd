{
  "name": "lightmd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/editor.js --bundle --outfile=src/editor.bundle.js --format=iife --minify",
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:js": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "markdown-it": "^15.0.1",
    "markdown-it-task-lists": "^2.1.1"
  }
}
